  "scripts": {
    "build": "tsc -b && vite build",
    "cf-typegen": "wrangler types",
    "check": "tsc && vite build && wrangler deploy --dry-run",
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "dev:frontend": "vite",
    "dev:all": "concurrently \"npm run dev:worker\" \"npm run dev:frontend\"",
    "lint": "eslint .",
    "test": "vitest",
