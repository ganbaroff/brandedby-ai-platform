# ====================
# DEVELOPMENT ENV FILE
# ====================
# Copy this file to .env.local and fill in your values

# ==================== MOCHA USERS SERVICE ====================
VITE_MOCHA_USERS_SERVICE_API_URL=https://users-api.mocha.com
VITE_MOCHA_USERS_SERVICE_API_KEY=your_mocha_api_key_here

# ==================== STRIPE ====================
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_test_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ==================== SENTRY ERROR TRACKING ====================
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
VITE_APP_VERSION=0.1.0

# ==================== CLOUDFLARE ====================
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_DATABASE_ID=your_d1_database_id

# ==================== GOOGLE OAUTH ====================
# (Handled by Mocha Users Service - configure in Mocha dashboard)

# ==================== EMAIL SERVICE ====================
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# ==================== API ENDPOINTS ====================
VITE_API_URL=http://localhost:8787
VITE_API_TIMEOUT=30000

# ==================== FEATURE FLAGS ====================
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_SENTRY=true
VITE_ENABLE_OFFLINE_MODE=false

# ==================== REDIS CACHE (Optional) ====================
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# ==================== AWS S3 (Optional for file storage) ====================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=brandedby-uploads
